{
  "name": "codex-control-center",
  "displayName": "Codex Control Center",
  "description": "Version-aware native composer controls for the OpenAI Codex VS Code extension.",
  "version": "0.2.0",
  "publisher": "andrianarivelo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Andrianarivelo/codex-control-center.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "codex",
    "openai",
    "reasoning",
    "usage",
    "compaction"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codexControl.applyPatch",
    "onCommand:codexControl.restoreOriginal"
  ],
  "main": "./src/extension.js",
  "extensionDependencies": [
    "openai.chatgpt"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexControl.applyPatch",
        "title": "Apply or Repair Native Controls",
        "category": "Codex Control"
      },
      {
        "command": "codexControl.restoreOriginal",
        "title": "Restore Original Codex UI",
        "category": "Codex Control"
      },
      {
        "command": "codexControl.showDiagnostics",
        "title": "Show Patch Diagnostics",
        "category": "Codex Control"
      },
      {
        "command": "codexControl.refreshUsage",
        "title": "Refresh Usage",
        "category": "Codex Control"
      }
    ],
    "configuration": {
      "title": "Codex Control Center",
      "properties": {
        "codexControl.updateIntervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "Minutes between Codex usage refreshes."
        },
        "codexControl.patchOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Reapply the native composer patch when Codex or VS Code updates."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test",
    "package": "npx @vscode/vsce package --allow-missing-repository",
    "vscode:uninstall": "node scripts/uninstall.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2",
    "jsdom": "^29.1.1"
  }
}
